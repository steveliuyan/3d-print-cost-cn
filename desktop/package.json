{
  "name": "print-cost-calculator",
  "productName": "3D打印成本计算器",
  "version": "1.8.3",
  "description": "3D 打印成本计算器：材料、设备折旧、电费、人工、后处理与失败率摊销，算出单件成本、建议售价与利润",
  "main": "main.js",
  "author": "刘焱",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "node build-win.js",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "@electron/packager": "^18.3.6",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dpc.printcost",
    "productName": "3D打印成本计算器",
    "directories": {
      "output": "../dist/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "3D打印成本计算器-1.8.3-便携版.exe"
    }
  }
}
