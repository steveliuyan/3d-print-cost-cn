# ===== 依赖与构建产物（不入库）=====
dist/
desktop/node_modules/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml

# 图标源脚本生成的中间文件（icon.ico 需要保留，打包要用）
desktop/build/icon.png

# ===== 签名密钥：绝对不要入库 =====
# 密钥库一旦公开，任何人都能签出与你同签名的 APK 来覆盖安装。
# 需要自行生成：见 README「Android 签名」一节。
*.jks
*.keystore
android/app/dpc-release.jks
android/keystore.properties

# ===== 凭据：绝不入库 =====
# .secrets/ 存放本机用的 token / 口令等，只在本机保留，永远不要提交或外发。
.secrets/
*.token
.env
.env.*

# ===== 本机 Agent 状态（工作日志等，不建议公开） =====
.workbuddy/

# ===== 图像生成工具的草稿产出（不入库）=====
generated-images/

# ===== 品牌/图标探索草稿（不入库；成品母版见 docs/brand/icon-master-{rounded,bleed}.png）=====
_icon_ai/
docs/brand/concepts/
_gen_brand_concepts.py
_render_concepts.js
_crop_icon.py

